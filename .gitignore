# Subprojects carry their own .gitignore (backend/.gitignore, mobile/.gitignore).
# This file is for repo-root and cross-cutting concerns only.

# ---- Node (root-level tooling scripts, if any) ----
/node_modules/
npm-debug.log*

# ---- Docker ----
docker-compose.override.yml

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp

# ---- Secrets (belt-and-braces; subprojects also ignore their own) ----
*.pem
!mobile/android/app/debug.keystore
.env
!**/.env.example

# ---- Scratch ----
/scratch/
/tmp/
