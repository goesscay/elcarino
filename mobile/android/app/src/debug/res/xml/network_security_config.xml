<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only (android/app/src/debug/, never merged into release) —
  permits plain http:// to the local dev backend hosts docs/08-environment-
  setup.md documents (10.0.2.2 for the Android emulator, localhost/127.0.0.1
  for a USB-connected device via `adb reverse tcp:8000 tcp:8000`). Every
  other host stays on the secure default (cleartextTrafficPermitted="false"
  below) — this never weakens a real HTTPS production/staging endpoint.

  Found necessary while fixing voice-note playback (Phase 3 item 1): Dart's
  own HTTP client (what the JSON API calls go through, via Dio) doesn't
  consult Android's Network Security Config at all, so those worked over
  cleartext with no config here — but a plugin backed by native Android
  networking does enforce it, and with no exception configured, that native
  layer's cleartext connection is refused before it ever leaves the device
  (confirmed live: `adb logcat` showed audioplayers' underlying
  `android.media.MediaPlayer` erroring with `NuCachedSource2: source
  returned error -1`, and the backend's own access log — restarted with
  output captured for this — recorded zero incoming requests for that
  attempt, timed against several JSON API calls that *did* arrive
  immediately over the same host in the same session).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
