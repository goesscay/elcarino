APP_NAME="Elcarino"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database ----
# Local dev: SQLite (no server). Staging/prod: pgsql (set via platform secrets).
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=elcarino
# DB_USERNAME=elcarino
# DB_PASSWORD=

# ---- Sessions / cache / queue ----
# Local dev uses the database driver (no Redis needed). Prod switches these to redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Auth / Sanctum ----
SANCTUM_STATEFUL_DOMAINS=localhost
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# ---- OAuth (Socialite) ----  [Phase 1]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=

# ---- SMS / OTP ----  [Phase 1 — provider-agnostic; default impl Twilio]
SMS_PROVIDER=log
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ---- Mail ----
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@elcarino.example"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Object storage (S3-compatible) ----  [Phase 1 — profile photos, chat media]
# Local dev: FILESYSTEM_DISK=local (private disk, storage/app/private, "serve" =>
# true in config/filesystems.php gives it Laravel's built-in signed temporaryUrl()
# support). Staging/prod: set to s3 — the same code path (Storage::disk(...)
# ->temporaryUrl()) then mints a real S3 presigned URL. No code change needed.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_SIGNED_URL_TTL_MINUTES=15
MEDIA_MAX_PHOTO_SIZE_KB=8192
MEDIA_MAX_PHOTO_DIMENSION=4096

# ---- Real-time (Laravel Reverb) ----  [Phase 1 — chat]
BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ---- Push notifications (FCM) ----  [Phase 1]
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# ---- Maps / geolocation ----  [Phase 1 — Google Maps or Mapbox, TBD]
MAPS_PROVIDER=
MAPS_API_KEY=
DISCOVERY_MAX_RADIUS_KM=200

# ---- AI ----  [Phase 4]
OPENAI_API_KEY=

# ---- Payments ----  [Phase 2 — provider TBD, open decision #27]
PAYMENTS_PROVIDER=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---- Monitoring ----  [Phase 5]
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
